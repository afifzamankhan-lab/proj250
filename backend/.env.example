# SUST CSE 23/24 Academic & Student Management System
# Server Configuration
PORT=8080
ENV=development
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sust_cse_portal
DB_SSLMODE=disable

# JWT Authentication Secrets
# (Never commit actual production secrets to GitHub)
JWT_SECRET=sust_cse_2023_2024_secure_jwt_access_secret_key_12345
JWT_REFRESH_SECRET=sust_cse_2023_2024_secure_jwt_refresh_secret_key_67890
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_API_PER_MIN=60
